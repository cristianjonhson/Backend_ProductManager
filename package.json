{
  "name": "product-manager-express",
  "version": "1.0.0",
  "description": "Product Manager with Express & nodemon",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js"
  },
  "dependencies": {
    "express": "4.18.2"
  },
  "devDependencies": {
    "nodemon": "3.0.3"
  },
  "nodemonConfig": {
    "ignore": [
      "src/app.js",
      "src/**/*.test.js",
      "node_modules"
    ],
    "watch": [
      "src"
    ]
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
